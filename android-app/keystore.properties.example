# Ecal Android Keystore Signing Configuration Example
# Copy this file to 'keystore.properties' and fill in your values.
# 'keystore.properties' is gitignored - passwords must NEVER be committed to version control.
#
# Generate a new release keystore (run once):
#   keytool -genkey -v -keystore release.keystore -alias ecal -keyalg RSA -keysize 2048 -validity 10000
#
# BACK UP YOUR KEYSTORE SECURELY:
# If you lose this keystore or password, no future release will be able to update an existing installation.
# Users would be forced to uninstall Ecal and lose local app data to install newer versions.

storeFile=keystore/release.keystore
storePassword=your_store_password_here
keyAlias=ecal
keyPassword=your_key_password_here
